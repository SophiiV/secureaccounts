{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "localhost",
  "App": {
    "BaseUrl": "http://localhost:5080"
  },
  "Security": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 5,
    "ActivationTokenHours": 24,
    "ResetTokenMinutes": 30,
    "Pbkdf2Iterations": 600000,
    "RateLimitPostsPerMinute": 20
  },
  "Smtp": {
    "Host": "127.0.0.1",
    "Port": 1025,
    "From": "no-reply@secureaccounts.local",
    "FromName": "SecureAccounts"
  },
  "Authentication": {
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    }
  }
}
