@page
@model SecureAccounts.Pages.Account.LoginWith2faModel
@{
    ViewData["Title"] = "Двофакторна автентифікація";
}
<div class="card auth-card mx-auto">
    <div class="card-body p-4">
        <h1 class="h4 mb-3">Двофакторна автентифікація</h1>
        <p>Пароль для <strong>@Model.Email</strong> вірний. Введіть 6-значний код із застосунку-автентифікатора
            (Google Authenticator, Microsoft Authenticator).</p>
        @if (Model.Error is not null)
        {
            <div class="alert alert-danger">@Model.Error</div>
        }
        <form method="post" novalidate>
            <input asp-for="Code" class="form-control code-input mb-3" inputmode="numeric" autocomplete="one-time-code"
                   maxlength="7" placeholder="000000" autofocus />
            <button type="submit" class="btn btn-primary w-100">Підтвердити</button>
        </form>
        <p class="small text-muted mt-3 mb-0">Код змінюється кожні 30 секунд. Невдалі спроби враховуються в лічильнику блокування.</p>
    </div>
</div>
