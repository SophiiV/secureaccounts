@page
@model SecureAccounts.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Новий пароль";
}
<div class="card auth-card mx-auto">
    <div class="card-body p-4">
        <h1 class="h4 mb-3">Встановлення нового пароля</h1>
        @if (Model.Done)
        {
            <div class="alert alert-success">Пароль змінено. Усі попередні сесії завершено, посилання більше не діє.</div>
            <a class="btn btn-primary" asp-page="/Account/Login">Увійти з новим паролем</a>
        }
        else if (!Model.TokenValid)
        {
            <div class="alert alert-danger">@Model.TokenError</div>
            <a class="btn btn-outline-primary" asp-page="/Account/ForgotPassword">Запросити нове посилання</a>
        }
        else
        {
            <p>Обліковий запис: <strong>@Model.Email</strong></p>
            <form method="post" novalidate>
                <input type="hidden" asp-for="Token" />
                <div class="mb-2">
                    <label asp-for="Input.Password" class="form-label"></label>
                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password" data-password-meter />
                    <div class="strength mt-2"><div id="strength-bar" class="strength-bar"></div></div>
                    <div id="strength-label" class="small text-muted mt-1"></div>
                </div>
                <ul class="rules small ps-1 mb-2">
                    <li data-rule="length">щонайменше 8 символів</li>
                    <li data-rule="upper">велика літера</li>
                    <li data-rule="lower">мала літера</li>
                    <li data-rule="digit">цифра</li>
                    <li data-rule="symbol">символ, що не є літерою чи цифрою</li>
                </ul>
                @if (Model.PasswordErrors.Count > 0)
                {
                    <div class="alert alert-danger py-2 small">
                        <ul class="mb-0">
                            @foreach (var e in Model.PasswordErrors)
                            {
                                <li>@e</li>
                            }
                        </ul>
                    </div>
                }
                <div class="mb-3">
                    <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100">Зберегти пароль</button>
            </form>
        }
    </div>
</div>
